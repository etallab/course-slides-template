% Blinding Commands
\newcommand\blind[2]{\if@common@blind{#2}\else{#1}\fi}
\NewEnviron{blinded}{
  \if@common@blind%
  \else%
    \BODY%
  \fi
}

% Auto-blind biblatex entries as necessary
\AtEndOfPackageFile{biblatex}{
  \if@common@blind
    \PackageInfo{mycommon}{Enabling blinding of biblatex entries with `keywords' contains `blinded'}
    \DeclareSourcemap{
      \maps[datatype=bibtex]{
        \map[overwrite=true]{
          \step[fieldsource=keywords,match=blinded,
               fieldset=author,fieldvalue={Blinded}]
        }
      }
    }
  \fi
}

% Provide compatibility with acmart mechanism for blinding
\AtEndOfClassFile*{acmart}{
  \PackageInfo{mycommon}{Enabling blinded/blind usage of ACM class implementations.}
  \if@ACM@anonymous
    \@common@blindtrue
  \else
    \@common@blindfalse
  \fi
  \renewcommand\blind[2]{\anon[#2]{#1}}
  \RenewEnviron{blinded}{
    \begin{anonsupress}
      \BODY
    \end{anonsupress}
  }
}


